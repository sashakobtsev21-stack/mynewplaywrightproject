# Copy to .env (or .env.public / .env.local depending on TEST_ENV) and fill in.

# Which environment to test against. Options: public | local
TEST_ENV=public

# Base URL for the system under test.
# public  -> https://automationintesting.online
# local   -> http://localhost (after running docker-compose up)
BASE_URL=https://automationintesting.online

# Admin credentials for the booking platform.
# Defaults for the public demo are admin / password (per project docs).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# Optional: Anthropic API key for the AI helpers.
# Without it the AI modules degrade to faker / local fallbacks.
ANTHROPIC_API_KEY=

# Optional: override the default model (claude-sonnet-4-5).
# AI_MODEL=claude-haiku-4-5

# Optional: choose the LLM vendor for the text helpers (data/test generator).
# anthropic (default) | openai. 'openai' targets ANY OpenAI-compatible endpoint:
#   OpenAI:       OPENAI_BASE_URL=https://api.openai.com/v1 + OPENAI_API_KEY
#   Local Ollama: OPENAI_BASE_URL=http://localhost:11434/v1 (no key needed)
# LLM_PROVIDER=anthropic
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional: ship AI traces to an OpenTelemetry collector (on top of local JSONL).
# Works with any OTLP/HTTP backend: Jaeger, Grafana Tempo, Honeycomb, otel-collector.
# TRACE_EXPORT=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=...,x-tenant=...
# OTEL_SERVICE_NAME=restful-booker-ai

# Optional: log level for pino. trace | debug | info | warn | error
LOG_LEVEL=info
