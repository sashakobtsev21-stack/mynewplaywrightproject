# Copy to .env (or .env.public / .env.local depending on TEST_ENV) and fill in.

# Which environment to test against. Options: public | local
TEST_ENV=public

# Base URL for the system under test.
# public  -> https://automationintesting.online
# local   -> http://localhost (after running docker-compose up)
BASE_URL=https://automationintesting.online

# Admin credentials for the booking platform.
# Defaults for the public demo are admin / password (per project docs).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# Optional: Anthropic API key for AI helper scripts (Phase 6).
# Without it the AI modules degrade to faker-based fallbacks.
ANTHROPIC_API_KEY=

# Optional: log level for pino. trace | debug | info | warn | error
LOG_LEVEL=info
