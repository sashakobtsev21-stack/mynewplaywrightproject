{
  "name": "restful-booker-tests",
  "version": "0.7.0",
  "private": true,
  "description": "End-to-end test automation for Restful-Booker Platform. Playwright + TypeScript with UI, API, visual, and contract tests.",
  "keywords": [
    "playwright",
    "typescript",
    "qa-automation",
    "test-automation",
    "e2e-testing",
    "api-testing"
  ],
  "homepage": "https://github.com/sashakobtsev21-stack/mynewplaywrightproject#readme",
  "bugs": {
    "url": "https://github.com/sashakobtsev21-stack/mynewplaywrightproject/issues"
  },
  "license": "MIT",
  "author": "Alexandr Kobtsev <225353912+sashakobtsev21-stack@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/sashakobtsev21-stack/mynewplaywrightproject.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "test:ui": "playwright test --project=chromium tests/regression/ui",
    "test:api": "playwright test --project=api",
    "test:contracts": "playwright test --project=api tests/api/contracts",
    "test:negative": "playwright test tests/negative",
    "test:perf": "playwright test --grep @perf",
    "test:visual": "playwright test --project=chromium tests/visual",
    "test:visual:update": "playwright test --project=chromium tests/visual --update-snapshots",
    "allure:generate": "bash scripts/publish-allure.sh",
    "allure:serve": "SERVE=1 bash scripts/publish-allure.sh",
    "ai:generate-test": "tsx scripts/generate-test.ts",
    "ai:analyze": "tsx scripts/analyze-failure.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "zod": "^3.24.1",
    "pino": "^9.6.0",
    "@faker-js/faker": "^9.5.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "@anthropic-ai/sdk": "^0.40.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.13.1",
    "typescript": "^5.9.2",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^2.2.0",
    "prettier": "^3.5.0",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "pino-pretty": "^13.0.0",
    "allure-playwright": "^3.2.0",
    "tsx": "^4.19.2"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
