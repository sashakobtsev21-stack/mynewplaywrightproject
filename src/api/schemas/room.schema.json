{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Room",
  "type": "object",
  "required": [
    "roomid",
    "roomName",
    "type",
    "accessible",
    "image",
    "description",
    "features",
    "roomPrice"
  ],
  "properties": {
    "roomid": { "type": "number" },
    "roomName": { "type": "string" },
    "type": { "type": "string" },
    "accessible": { "type": "boolean" },
    "image": { "type": "string" },
    "description": { "type": "string" },
    "features": { "type": "array", "items": { "type": "string" } },
    "roomPrice": { "type": "number" }
  }
}
