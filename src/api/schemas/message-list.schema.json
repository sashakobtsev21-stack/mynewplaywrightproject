{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MessageListResponse",
  "type": "object",
  "required": ["messages"],
  "properties": {
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "subject", "read"],
        "properties": {
          "id": { "type": "number" },
          "name": { "type": "string" },
          "subject": { "type": "string" },
          "read": { "type": "boolean" }
        }
      }
    }
  }
}
